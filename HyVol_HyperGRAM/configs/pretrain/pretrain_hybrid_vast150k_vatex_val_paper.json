{
  "run_cfg": {
    "default": "./configs/default_run_cfg.json",
    "output_dir": "output2/hybrid_vast150k_vatex_val",
    "learning_rate": 5e-5,
    "train_epoch": 1,
    "checkpointing": true,
    "save_steps": 2000,
    "log_steps": 100,
    "first_eval": true,
    "save_best": true,
    "fp16": true,
    "grad_norm": 1.0,
    "valid_freq": 20,
    "pretrain_dir": "pretrained_models/pretrain_vast"
  },

  "model_cfg": {
    "default": "./configs/default_model_cfg.json",
    "geometry_mode": "hybrid",
    "curvature_init": 1.0,
    "learn_curvature": true,
    "initial_euclidean_weight": 0.5,
    "initial_hyperbolic_weight": 0.5,
    "learn_hybrid_weights": true,
    "gradient_clip_hyperbolic": 1.0,
    "max_subtitle_len": 70
  },

  "data_cfg": {
    "train": [{
      "type": "annoindexed",
      "training": true,
      "name": "finetune_area",
      "txt": "datasets/VAST150K/annotations150k_clean.json",
      "vision": "datasets/VAST150K/video_clips/",
      "audio": "datasets/VAST150K/audio_clips/",
      "vision_format": "video_rawvideo",
      "vision_sample_num": 2,
      "audio_sample_num": 1,
      "task": "ret%tvas%tv%ta",
      "epoch": 1,
      "n_workers": 8,
      "batch_size": 128
    }],

    "val": [{
      "type": "annoindexed",
      "training": false,
      "name": "vatex_ret",
      "txt": "datasets/annotations/vatex/descs_ret_test.json",
      "vision": "datasets/vatex/vatex-dataset",
      "audio": "datasets/vatex/audio",
      "vision_format": "video_rawvideo",
      "vision_sample_num": 8,
      "audio_sample_num": 1,
      "task": "ret%tva",
      "n_workers": 8,
      "batch_size": 64
    }]
  }
}
